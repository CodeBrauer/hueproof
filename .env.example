# Public address of the deployed site, without a trailing slash. May include a path when the site
# does not sit at the root of its domain; that path becomes Next's basePath.
# Used for absolute links in the Open Graph image tag, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://tools.codebrauer.com/hueproof

# Only for `pnpm ship`: the SSH target that scripts/deploy.sh copies `out/` to.
# DEPLOY_HOST=user@example.com
# DEPLOY_PATH=/var/www/example.com/hueproof/
